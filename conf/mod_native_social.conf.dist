#
# Native Social -- account-level presence foundation
# Requires mod-content-manager; the client patch ships as a Content Manager
# package built from this module's content/ directory.
#

# Enable the Native Social module. When disabled, no profile, presence or
# command feature is active and pending presence data is dropped.
#    Default: 1 (enabled)
NativeSocial.Enable = 1

# Minimum length (in display characters) of a Native Social display name.
#    Default: 3
NativeSocial.DisplayNameMinLength = 3

# Maximum length (in display characters) of a Native Social display name.
# Names longer than 48 characters are refused regardless of this setting.
#    Default: 24
NativeSocial.DisplayNameMaxLength = 24

# Prefix used by mod-playerbots for generated random-bot authentication
# accounts. Matching is performed in the auth database, so offline bots are
# excluded without a runtime dependency on Playerbots. Set empty only when the
# realm does not use prefixed Playerbot accounts.
NativeSocial.PlayerbotAccountPrefix = "rndbot"

# Comma-separated authentication usernames that are never eligible for Native
# Social. Matching is case-insensitive; surrounding whitespace and empty list
# entries are ignored. This filtering is server-side and usernames are never
# exposed through the public Players directory.
#    Default: "AHBOT"
NativeSocial.ExcludedAccounts = "AHBOT"
